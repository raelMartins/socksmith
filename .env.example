# Admin dashboard (set strong values in production)
ADMIN_PASSWORD=change-me-to-a-long-random-password
ADMIN_JWT_SECRET=change-me-to-a-random-string-at-least-32-chars-long

# Waitlist export secret (GET /api/waitlist with header x-waitlist-secret)
WAITLIST_SECRET=change-me-to-a-long-random-export-secret

# Upstash Redis — required in production (Vercel). Locally optional (falls back to waitlist.json).
# Create a free Redis DB: https://console.upstash.com → Redis → Create → REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
